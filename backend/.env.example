DATABASE_URL=postgresql://postgres:password@localhost:5432/xenocrm

# ── Gemini API Key Rotation Pool ──────────────────────────────────────────────
# The CRM supports up to 5 Gemini API keys for automatic rate-limit rotation.
# On a 429 error, the system rotates to the next available key automatically.
# Each Gemini Free Tier key provides 20 RPM quota. With 5 keys = 100 RPM total.
#
# Add all your generated keys here:
GEMINI_KEY_1=your_gemini_api_key_1_here
GEMINI_KEY_2=your_gemini_api_key_2_here
GEMINI_KEY_3=your_gemini_api_key_3_here
GEMINI_KEY_4=your_gemini_api_key_4_here
GEMINI_KEY_5=your_gemini_api_key_5_here

# Legacy OpenAI-compatible settings (used automatically from GEMINI_KEY_1)
OPENAI_API_KEY=your_gemini_api_key_1_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

CHANNEL_STUB_URL=http://localhost:8001
CRM_RECEIPT_URL=http://localhost:8000
