# channel-stub/.env.example
# --------------------------
# Copy this to `.env` and update the URL to match your CRM backend.
# This file is safe to commit to git — no secrets here.

# ── CRM Callback URL ──────────────────────────────────────────────────────────
# WHERE to send delivery event callbacks.
# The Channel Stub will POST to {CRM_RECEIPT_URL}/receipts for each event.
#
# Local development: CRM runs on port 8000
CRM_RECEIPT_URL=http://localhost:8000

# Production (Railway): Update to your deployed CRM backend URL
# CRM_RECEIPT_URL=https://your-crm-backend.railway.app
